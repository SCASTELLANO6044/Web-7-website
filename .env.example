# Used by /api/contact. Create a Resend account and verify your website domain.
# These values are server-only: add them in Vercel, never expose them with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=web7canarias@gmail.com
# Must use a domain verified in Resend, e.g. "Web7 <contact@yourdomain.com>".
CONTACT_FROM_EMAIL="Web7 <contact@yourdomain.com>"

# Canonical production origin used in search metadata and the sitemap.
SITE_URL=https://web7devs.com
# Optional: value of the Google Search Console HTML verification meta tag.
GOOGLE_SITE_VERIFICATION=
